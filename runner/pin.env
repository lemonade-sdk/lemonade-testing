# What lemonade's CI runs repo-manager with. Lemonade's workflow reads nothing from here
# directly: it clones this repository and runs runner/run.sh, which sources this file.
# Revving a pin is a change to this repository alone.

# The repo-manager release (a git tag). The pi version it was tuned against is read back
# from that release with `repo-manager pi version`, so it is not pinned here.
REPO_MANAGER_VERSION=v1.0.4

# The model repo-manager's skills are tuned on, served by a lemond the job starts.
REPO_MANAGER_MODEL=Qwen3.6-35B-A3B-MTP-GGUF
LEMONADE_VERSION=11.9.0

# Tools the job installs into its own temp directory and throws away.
GH_CLI_VERSION=2.101.0
UV_VERSION=0.11.7
PYTHON_VERSION=3.12
NODE_VERSION=22.22.1
